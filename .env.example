GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Yoga Posture Tracker TTS
# Pass these with --dart-define-from-file=.env for local builds.
YOGA_TTS_PROVIDER=auto
YOGA_TTS_VOLUME=1.0
YOGA_TTS_LANGUAGE=en-US
YOGA_TTS_SPEECH_RATE=0.45
YOGA_TTS_PITCH=1.0
YOGA_TTS_VOICE_NAME=
YOGA_TTS_VOICE_LOCALE=

# Provider options:
# - auto/native/platform: local device TTS via flutter_tts (default)
# - logging/off/disabled: no audible playback, log only
